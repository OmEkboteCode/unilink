# GEMINI_API_KEY: Required for future server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ALLOWED_COLLEGE_DOMAINS: Comma-separated list of verified campus email domains or suffixes.
# Examples: "bmsce.ac.in,rvce.edu.in" or "ac.in,edu"
ALLOWED_COLLEGE_DOMAINS="ac.in,edu"

# STRICT_COLLEGE_DOMAIN_ONLY: Set to "true" to block non-college emails at campus verification checks.
# Default "false" allows Google-authenticated pilot evaluation while clearly labeling domain status.
STRICT_COLLEGE_DOMAIN_ONLY="false"
